# Copy this file to .env. Never commit the populated .env file.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Public Client ID from the GitHub OAuth App used for local development.
# Configure its callback URL as http://localhost:8081/auth.
# This value must match GITHUB_CLIENT_ID in the backend .env file.
EXPO_PUBLIC_GITHUB_CLIENT_ID=

# Public Client ID from a Google OAuth client of type "Web application".
# Authorized JavaScript origin: http://localhost:8081
# Authorized redirect URI: http://localhost:8081/auth
# This value must match GOOGLE_WEB_CLIENT_ID in the backend .env file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public Android OAuth Client ID. Only required for Android login testing.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
